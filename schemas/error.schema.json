{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/canopen-interop/schemas/error.schema.json",
  "type": "object",
  "title": "canopen-interop error document",
  "required": [
    "schemaVersion",
    "type",
    "code",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "type": {
      "const": "error"
    },
    "code": {
      "enum": [
        "usage",
        "unsupported",
        "timeout",
        "internal",
        "interface",
        "protocol"
      ]
    },
    "message": {
      "type": "string"
    },
    "abortCode": {
      "type": "string",
      "pattern": "^0x[0-9A-F]{8}$"
    },
    "step": {
      "type": "string"
    },
    "lssError": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    }
  }
}
