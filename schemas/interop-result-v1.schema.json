{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/engineering/templates/interop/interop-result-v1.schema.json",
  "title": "OT Fabric interop run results v1",
  "description": "One interop run of an OT Fabric harness or consumer suite (standards/interoperability.md#results, ADR-0007). Only outcome 'pass' counts as passing.",
  "type": "object",
  "required": ["schemaVersion", "repository", "gitSha", "startedAt", "finishedAt", "host", "implementations", "summary", "results", "reproduce"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "repository": { "type": "string", "description": "e.g. otfabric/canopen-interop" },
    "interopVersion": { "type": "string", "pattern": "^v?\\d+\\.\\d+\\.\\d+$" },
    "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "gate": { "type": "string", "description": "Implementation under test; only results involving it gate the run." },
    "host": {
      "type": "object",
      "required": ["os", "arch"],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "kernel": { "type": "string" },
        "runner": { "type": "string" }
      }
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "upstream": { "type": "string" },
          "version": { "type": "string" },
          "revision": { "type": "string" },
          "image": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$", "description": "Required for container-based implementations." },
          "license": { "type": "string", "description": "SPDX identifier" },
          "independent": { "type": "boolean", "description": "false for the implementation under test or its forks" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "unsupported", "not-tested", "known-difference", "infra-error"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "not-tested": { "type": "integer", "minimum": 0 },
        "known-difference": { "type": "integer", "minimum": 0 },
        "infra-error": { "type": "integer", "minimum": 0 }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "evidence", "reproduced"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "scope": { "type": "string", "description": "role@implementation" },
          "evidence": { "type": "string", "format": "uri", "description": "Issue or commit URL pinned upstream" },
          "reproduced": { "type": "boolean", "description": "false fails the run (stale waiver)" }
        }
      }
    },
    "reproduce": { "type": "string", "description": "Exact command that reproduces this run" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "suite", "roles", "outcome", "durationMs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "Stable dotted scenario ID; never a display string" },
          "title": { "type": "string" },
          "suite": { "type": "string" },
          "feature": { "type": "string" },
          "protocolVersion": { "type": "string" },
          "roles": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string" },
            "description": "role → implementation name, e.g. {\"client\":\"go-ocpp\",\"server\":\"mobilityhouse\"}"
          },
          "platform": { "type": "string" },
          "outcome": { "enum": ["pass", "fail", "unsupported", "not-tested", "known-difference", "infra-error"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string" },
          "waiver": { "type": "string", "description": "Waiver id from waivers[]" },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
          },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "Artifact paths (logs, pcaps)" }
        },
        "allOf": [
          { "if": { "properties": { "outcome": { "not": { "const": "pass" } } } }, "then": { "required": ["reason"] } },
          { "if": { "properties": { "outcome": { "const": "known-difference" } } }, "then": { "required": ["waiver"] } }
        ]
      }
    }
  }
}
