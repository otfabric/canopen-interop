            }
          },
          "additionalProperties": false
        },
        "sync": {
          "type": "boolean"
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "title": "result of mpdo-send",
      "required": [
        "schemaVersion",
        "type",
        "operation",
        "node",
        "mode",
        "cobId",
        "sent"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "result"
        },
        "operation": {
          "const": "mpdo-send"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
