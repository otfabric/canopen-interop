{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/canopen-interop/schemas/result.schema.json",
  "title": "canopen-interop result document",
  "oneOf": [
    {
      "type": "object",
      "title": "result of device",
      "required": [
        "schemaVersion",
        "type",
        "operation",
        "node",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "result"
        },
        "operation": {
          "const": "device"
        },
        "node": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            },
            {
              "const": 255
            }
          ]
        },
        "values": {
          "type": "object",
          "patternProperties": {
            "^0x[0-9A-F]{4}:[0-9A-F]{2}$": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "nodeId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    {
      "type": "object",
      "title": "result of sdo-upload",
      "required": [
        "schemaVersion",
        "type",
        "operation",
        "node",
        "index",
        "subindex",
        "block",
        "size",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "result"
        },
        "operation": {
          "const": "sdo-upload"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "index": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{4}$"
        },
        "subindex": {
          "type": "integer"
        },
        "block": {
          "type": "boolean"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        }
      }
    },
    {
      "type": "object",
      "title": "result of sdo-download",
      "required": [
        "schemaVersion",
        "type",
        "operation",
        "node",
        "index",
        "subindex",
        "block",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "result"
        },
        "operation": {
          "const": "sdo-download"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "index": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{4}$"
        },
        "subindex": {
          "type": "integer"
        },
        "block": {
          "type": "boolean"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "title": "result of nmt",
      "required": [
        "schemaVersion",
        "type",
        "operation",
        "node",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "result"
        },
        "operation": {
          "const": "nmt"
        },
        "node": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "command": {
          "enum": [
            "start",
            "stop",
            "pre-operational",
            "reset-node",
            "reset-communication"
          ]
        }
      }
    },
    {
      "type": "object",
      "title": "result of listen",
      "required": [
        "schemaVersion",
        "type",
        "operation",
        "received",
        "complete"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "result"
