{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/canopen-interop/schemas/event.schema.json",
  "title": "canopen-interop event stream line",
  "oneOf": [
    {
      "type": "object",
      "title": "ready",
      "required": [
        "schemaVersion",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "ready"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        }
      }
    },
    {
      "type": "object",
      "title": "bootup",
      "required": [
        "schemaVersion",
        "type",
        "node"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "bootup"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        }
      }
    },
    {
      "type": "object",
      "title": "heartbeat",
      "required": [
        "schemaVersion",
        "type",
        "node",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "heartbeat"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "state": {
          "enum": [
            "initialising",
            "pre-operational",
            "operational",
            "stopped"
          ]
        }
      }
    },
    {
      "type": "object",
      "title": "emcy",
      "required": [
        "schemaVersion",
        "type",
        "node",
        "code",
        "register",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "emcy"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "code": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{4}$"
        },
        "register": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{2}$"
        },
        "data": {
          "type": "string",
          "pattern": "^([0-9a-f]{2}){0,5}$"
        }
      }
    },
    {
      "type": "object",
      "title": "pdo",
      "required": [
        "schemaVersion",
        "type",
        "node",
        "pdo",
        "cobId",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "pdo"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "pdo": {
          "type": "integer"
        },
        "cobId": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{3,8}$"
        },
        "values": {
          "type": "object",
          "patternProperties": {
            "^0x[0-9A-F]{4}:[0-9A-F]{2}$": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "type": "object",
      "title": "cia402-state",
      "required": [
        "schemaVersion",
        "type",
        "node",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "cia402-state"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "state": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "title": "lss",
      "required": [
        "schemaVersion",
        "type",
        "step"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "lss"
        },
        "step": {
          "enum": [
            "switch-global",
            "switch-selective",
            "configure-node-id",
            "configure-bit-timing",
            "activate-bit-timing",
            "store",
            "inquire",
            "fastscan",
            "assign-all"
          ]
        },
        "mode": {
          "enum": [
            "waiting",
            "configuration"
          ]
        },
        "address": {
          "type": "object",
          "required": [
            "vendorId",
            "productCode",
            "revision",
            "serial"
          ],
          "additionalProperties": false,
          "properties": {
            "vendorId": {
              "type": "string",
              "pattern": "^0x[0-9A-F]{8}$"
            },
            "productCode": {
              "type": "string",
              "pattern": "^0x[0-9A-F]{8}$"
            },
            "revision": {
              "type": "string",
              "pattern": "^0x[0-9A-F]{8}$"
            },
            "serial": {
              "type": "string",
              "pattern": "^0x[0-9A-F]{8}$"
            }
          }
        },
        "node": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "what": {
          "enum": [
            "vendor-id",
            "product-code",
            "revision",
            "serial",
            "node-id"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{8}$"
        },
        "tableIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "kbps": {
          "type": "integer",
          "minimum": 0
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "store": {
          "type": "boolean"
        },
        "assigned": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node",
              "address"
            ],
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "integer",
                "minimum": 1,
                "maximum": 127
              },
              "address": {
                "type": "object",
                "required": [
                  "vendorId",
                  "productCode",
                  "revision",
                  "serial"
                ],
                "additionalProperties": false,
                "properties": {
                  "vendorId": {
                    "type": "string",
                    "pattern": "^0x[0-9A-F]{8}$"
                  },
                  "productCode": {
                    "type": "string",
                    "pattern": "^0x[0-9A-F]{8}$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^0x[0-9A-F]{8}$"
                  },
                  "serial": {
                    "type": "string",
                    "pattern": "^0x[0-9A-F]{8}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "title": "node-id",
      "required": [
        "schemaVersion",
        "type",
        "node"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "node-id"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    {
      "type": "object",
      "title": "bit-rate",
      "required": [
        "schemaVersion",
        "type",
        "kbps",
        "delayMs"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "bit-rate"
        },
        "kbps": {
          "type": "integer",
          "minimum": 0
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    {
      "type": "object",
      "title": "mpdo",
      "required": [
        "schemaVersion",
        "type",
        "node",
        "index",
        "subindex",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "mpdo"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "index": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{4}$"
        },
        "subindex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "data": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        }
      }
    },
    {
      "type": "object",
      "title": "boot",
      "required": [
        "schemaVersion",
        "type",
        "node",
        "ok",
        "errorStatus",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "type": {
          "const": "boot"
        },
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "ok": {
          "type": "boolean"
        },
        "errorStatus": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-O]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    {
      "$ref": "result.schema.json"
    },
    {
      "$ref": "error.schema.json"
    }
  ]
}
