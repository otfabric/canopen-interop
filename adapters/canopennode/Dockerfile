# SPDX-License-Identifier: MIT
# canopen-interop adapter: CANopenNode v4.1 with CANopenLinux (Apache-2.0)
# on SocketCAN.
#
#   canopend         CANopenLinux's canopend with CANopenNode's example Object
#                    Dictionary (DS301_profile): the master role, through its
#                    CiA 309-3 ASCII gateway on stdio (SDO client incl. block
#                    transfer, NMT master, heartbeat and EMCY consumers).
#   canopend-device  canopend with the Object Dictionary of the shared test
#                    device (fixtures/eds/interop-device.eds), generated by
#                    CANopenEditor v4.2.3 (EDSSharp, --type CanOpenNodeV4) in
#                    the first stage, and the device application
#                    adapters/canopennode/app_interop.c.
#
# adapter.py only translates the container contract to canopend's command
# line, its ASCII gateway and the application's output.
#
# One upstream fix is applied to v4.1: CANopenNode commit cf85a4c (master,
# 2026-05-31, PR #627, issue #623) enlarges the gateway's command token
# buffer to 21 bytes; in v4.1 "lss_activate_bitrate" (20 characters) always
# fails with a syntax error.
# Build context: the repository root (make image-canopennode).

ARG BASE_REGISTRY=docker.io/library
ARG DOTNET_REGISTRY=mcr.microsoft.com

# ── Object Dictionary of the test device, generated by CANopenEditor ────────
FROM ${DOTNET_REGISTRY}/dotnet/sdk:8.0-bookworm-slim@sha256:6ba9644da07bb5b560a402acec9ca38711a0762969f1b61da261df5c9f6f85da AS od
ARG CANOPENEDITOR_VERSION=v4.2.3
ARG CANOPENEDITOR_SHA256=37e5d635ddf11728fc993edbdc8c96583bae6c7e6f2589fa884f70681223e279
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# libEDSsharp runs "git describe" for its version string and the x64 protoc of
# the Google.Protobuf.Tools package: replaced by the tag and Debian's protoc
# (which runs on arm64 too).
RUN curl -fsSLo editor.tar.gz "https://github.com/CANopenNode/CANopenEditor/archive/refs/tags/${CANOPENEDITOR_VERSION}.tar.gz" \
    && echo "${CANOPENEDITOR_SHA256}  editor.tar.gz" | sha256sum -c - \
    && tar xzf editor.tar.gz \
    && cd "CANopenEditor-${CANOPENEDITOR_VERSION#v}" \
    && sed -i -e "s#git describe --tags --long --dirty#echo ${CANOPENEDITOR_VERSION}#" \
              -e 's#$(NugetPackageRoot)google.protobuf.tools/3.27.2/tools/linux_x64/protoc#/usr/bin/protoc#' \
              libEDSsharp/libEDSsharp.csproj \
    && dotnet publish EDSSharp/EDSSharp.csproj -c Release -f net8.0 -p:BuildNet8=true -o /opt/edssharp
COPY fixtures/eds/interop-device.eds /od/interop-device.eds
COPY adapters/canopennode/od-counts.sh /usr/local/bin/od-counts.sh
RUN dotnet /opt/edssharp/EDSSharp.dll --type CanOpenNodeV4 --infile /od/interop-device.eds --outfile /od/OD.c \
    && test -s /od/OD.c && test -s /od/OD.h \
    && sh /usr/local/bin/od-counts.sh /od/OD.h \
    && grep '^#define OD_CNT' /od/OD.h

# ── canopend (master) and canopend-device ──────────────────────────────────
FROM ${BASE_REGISTRY}/debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8 AS build
ARG CANOPENNODE_VERSION=v4.1
ARG CANOPENNODE_SHA256=c48bfb5a5205bf745d77b837be8d1c819cc8fe0e812b3b6fc1fda0b9641295f8
ARG CANOPENLINUX_REVISION=f1348d4072cdabea4c3435a13c721ac29ab4cc91
ARG CANOPENLINUX_SHA256=806b1b2e22561a537a1e40df16f1c0aae84d5e0c1128e93bfcde197774bcb640
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gcc libc6-dev make \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN curl -fsSLo node.tar.gz "https://github.com/CANopenNode/CANopenNode/archive/refs/tags/${CANOPENNODE_VERSION}.tar.gz" \
    && echo "${CANOPENNODE_SHA256}  node.tar.gz" | sha256sum -c - \
    && curl -fsSLo linux.tar.gz "https://github.com/CANopenNode/CANopenLinux/archive/${CANOPENLINUX_REVISION}.tar.gz" \
    && echo "${CANOPENLINUX_SHA256}  linux.tar.gz" | sha256sum -c - \
    && tar xzf node.tar.gz && tar xzf linux.tar.gz \
    && mv "CANopenLinux-${CANOPENLINUX_REVISION}" master \
    && rmdir master/CANopenNode && cp -a "CANopenNode-${CANOPENNODE_VERSION#v}" master/CANopenNode \
    && sed -i 's/^        char tok\[20\];$/        char tok[21];/' master/CANopenNode/309/CO_gateway_ascii.c \
    && grep -q '^        char tok\[21\];$' master/CANopenNode/309/CO_gateway_ascii.c \
    && cp -a master device \
    && mkdir -p /out/bin /out/src /out/licenses \
    && cp node.tar.gz "/out/src/CANopenNode-${CANOPENNODE_VERSION}.tar.gz" \
    && cp linux.tar.gz "/out/src/CANopenLinux-${CANOPENLINUX_REVISION}.tar.gz" \
    && cp master/LICENSE /out/licenses/CANopenLinux-LICENSE \
    && cp master/CANopenNode/LICENSE /out/licenses/CANopenNode-LICENSE
# The master: canopend as CANopenLinux builds it (CANopenNode/example OD).
RUN make -C master -j"$(nproc)" canopend && cp master/canopend /out/bin/canopend
# The device: generated OD, the application, no storage (the test device has
# no 0x1010/0x1011) and no gateway; it boots into pre-operational and waits
# for NMT start (no CO_NMT_STARTUP_TO_OPERATIONAL), as CiA 301 devices do.
COPY --from=od /od/OD.c /od/OD.h /src/device/appl/
COPY adapters/canopennode/app_interop.c /src/device/appl/
RUN sed -i 's#^\t$(APPL_SRC)/OD.c \\#\t$(APPL_SRC)/OD.c \\\n\t$(APPL_SRC)/app_interop.c \\#' device/Makefile \
    && grep -q app_interop.c device/Makefile \
    && make -C device -j"$(nproc)" canopend APPL_SRC=appl \
        OPT='-g -O2 -DCO_SINGLE_THREAD -DCO_USE_APPLICATION -DCO_CONFIG_STORAGE=0 -DCO_CONFIG_GTW=0 -DCO_CONFIG_HB_CONS=0 -DCO_CONFIG_SDO_CLI=0 -DOD_PERSIST_COMM=OD_RAM -Dx1018_identity=x1018_identityObject -DMAIN_THREAD_INTERVAL_US=10000 "-DNMT_CONTROL=(CO_NMT_ERR_ON_ERR_REG|CO_ERR_REG_GENERIC_ERR|CO_ERR_REG_COMMUNICATION)"' \
    && cp device/canopend /out/bin/canopend-device \
    && cp device/appl/OD.c device/appl/OD.h /out/src/

FROM ${BASE_REGISTRY}/python:3.12-slim-bookworm@sha256:6dd8b6dab6b3adc7812bab69eca5dbdc1a5cc690ad28306d234ffb4ef8ac9753
ARG ADAPTER_VERSION=dev
ENV UPSTREAM_VERSION=v4.1 \
    UPSTREAM_REVISION=ac2140717c3c498d9b0351bce052bab630a74764 \
    CANOPENLINUX_REVISION=f1348d4072cdabea4c3435a13c721ac29ab4cc91 \
    CANOPENEDITOR_VERSION=v4.2.3 \
    ADAPTER_VERSION=${ADAPTER_VERSION} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/canopen-interop
COPY --from=build /out/bin/ /usr/local/bin/
COPY --from=build /out/src/ /usr/share/src/canopennode/
COPY --from=build /out/licenses/ /usr/share/doc/canopennode/
COPY adapters/common/coi.py adapters/canopennode/adapter.py /opt/canopen-interop/
COPY fixtures /fixtures
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/canopen-interop/
COPY licenses /usr/share/doc/canopen-interop/licenses
RUN printf '#!/bin/sh\nexec python3 /opt/canopen-interop/adapter.py "$@"\n' > /usr/local/bin/canopen-interop \
    && chmod 0755 /usr/local/bin/canopen-interop \
    && useradd --system --no-create-home --uid 10001 canopen
USER canopen
WORKDIR /tmp

LABEL org.opencontainers.image.source="https://github.com/otfabric/canopen-interop" \
      org.opencontainers.image.description="canopen-interop adapter: CANopenNode v4.1 with CANopenLinux (canopend)" \
      org.opencontainers.image.version="${ADAPTER_VERSION}" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0"

ENTRYPOINT ["canopen-interop"]
CMD ["print-capabilities"]
